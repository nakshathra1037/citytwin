# Living City Backend Environment Configuration

# Application
APP_NAME="Living City Urban AI Platform"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Security & JWT
JWT_SECRET="livingcity_super_secret_jwt_key_2026_urban_intelligence_99x"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Configuration
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="living_city_db"

# External Data APIs
# OpenWeather API (https://openweathermap.org/api)
OPENWEATHER_API_KEY=""

# TomTom Traffic API (https://developer.tomtom.com/)
TOMTOM_API_KEY=""

# Air Quality API (OpenWeather Air Pollution uses OpenWeather key; or specify custom AQI endpoint/key)
AQI_API_KEY=""

# Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
